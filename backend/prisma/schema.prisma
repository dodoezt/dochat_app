generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model users {
  userId                                  Int                    @id @default(autoincrement())
  username                                String                 @unique(map: "username_UNIQUE") @db.VarChar(20)
  provider                                String                 @db.VarChar(255)
  email                                   String?                @unique(map: "email_UNIQUE") @db.VarChar(255)
  email_name                              String?                @db.VarChar(255)
  phone_number                            String?                @unique(map: "phone_number_UNIQUE") @db.VarChar(255)
  dial_code                               String?                @db.VarChar(255)
  createdAt                               DateTime               @db.DateTime(0)
  conversationMembers                     conversation_members[] @relation("UserConversationMembers")
  friendships_friendships_userIdTousers   friendships[]          @relation("friendships_userIdTousers")
  friendships_friendships_friendIdTousers friendships[]          @relation("friendships_friendIdTousers")
  sentMessages                            messages[]             @relation("UserSentMessages")
  notifications                           notifications[]
  user_atribut                            user_atribut?

  @@map("users")
}

model conversation_members {
  id             Int           @id @default(autoincrement())
  userId         Int
  conversationId String        @db.VarChar(36)
  joinedAt       DateTime      @default(now()) @db.DateTime(0)
  user           users         @relation("UserConversationMembers", fields: [userId], references: [userId], onDelete: Cascade, onUpdate: NoAction, map: "conversation_members_ibfk_1")
  conversation   conversations @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "conversation_members_ibfk_2")

  @@unique([userId, conversationId], map: "unique_member")
  @@index([conversationId], map: "conversationId")
  @@map("conversation_members")
}

model messages {
  id             String          @id @unique(map: "id_UNIQUE") @db.VarChar(36)
  content        String          @db.Text
  sentAt         DateTime        @default(now()) @db.DateTime(0)
  status         messages_status @default(NOT_DELIVERED)
  senderId       Int
  senderUsername String          @db.VarChar(20)
  senderPfp_id   String?         @db.VarChar(100)
  conversationId String          @db.VarChar(36)
  seen_by        Json?
  sender         users           @relation("UserSentMessages", fields: [senderId], references: [userId], onDelete: Cascade, onUpdate: NoAction, map: "messages_ibfk_1")
  conversation   conversations   @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "messages_ibfk_2")

  @@index([conversationId], map: "conversationId")
  @@index([senderId], map: "senderId")
  @@map("messages")
}

model conversations {
  id             String                 @id @unique(map: "id_UNIQUE") @default(cuid()) @db.VarChar(36)
  isGroup        Boolean                @default(false)
  createdAt      DateTime               @default(now()) @db.DateTime(0)
  members        conversation_members[]
  group_atributs group_atributs?
  messages       messages[]

  @@map("conversations")
}

model tags {
  id   Int       @id @default(autoincrement())
  name String    @unique(map: "name_UNIQUE") @db.VarChar(100)
  tier tags_tier @default(Common)
}

model user_atribut {
  id         Int     @id @default(autoincrement())
  userId     Int     @unique(map: "userId_UNIQUE")
  pfp_id     String? @db.VarChar(100)
  tags_used  Json?
  owned_tags Json?
  pronounces Json?
  bio        String? @db.VarChar(200)
  users      users   @relation(fields: [userId], references: [userId], onDelete: Cascade, map: "fk_user_id")
}

model friendships {
  id                                Int                 @id @default(autoincrement())
  userId                            Int
  friendId                          Int
  status                            friendships_status? @default(pending)
  created_at                        DateTime?           @default(now()) @db.Timestamp(0)
  users_friendships_userIdTousers   users               @relation("friendships_userIdTousers", fields: [userId], references: [userId], onDelete: Cascade, onUpdate: NoAction, map: "friendships_ibfk_1")
  users_friendships_friendIdTousers users               @relation("friendships_friendIdTousers", fields: [friendId], references: [userId], onDelete: Cascade, onUpdate: NoAction, map: "friendships_ibfk_2")

  @@unique([userId, friendId], map: "unique_pair")
  @@index([friendId], map: "friendId")
}

model notifications {
  id      Int                @id @default(autoincrement())
  userId  Int
  type    notifications_type
  content String             @db.Text
  users   users              @relation(fields: [userId], references: [userId], onDelete: NoAction, onUpdate: NoAction, map: "fk_notifications_userId")

  @@index([userId], map: "fk_notifications_userId")
}

model group_atributs {
  id                Int           @id @default(autoincrement())
  conversationId    String        @unique(map: "conversationId_UNIQUE") @db.VarChar(36)
  group_name        String        @default("New Group") @db.VarChar(40)
  group_description String?       @db.VarChar(200)
  group_pfp         String?       @db.VarChar(100)
  conversations     conversations @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_group_convId")
}

enum messages_status {
  NOT_DELIVERED
  DELIVERED
  SEEN
}

enum tags_tier {
  Common
  Kinda_Cool  @map("Kinda Cool")
  Absolute_OG @map("Absolute OG")
}

enum friendships_status {
  pending
  accepted
  declined
  blocked
}

enum notifications_type {
  FRIENDSHIPS
}
